#!/usr/bin/env bash
# grok-review — 用 Grok Build 只读审查一段 git diff（跨模型预合并审查）
#              Read-only cross-model review of a git diff via Grok Build.
#
# Codex is the main agent; this script is a helper it dispatches.
# Never merges, pushes, or deletes.

set -euo pipefail

SCRIPT_NAME=$(basename -- "$0")

DEFAULT_TIMEOUT=300
MAX_DIFF_BYTES=400000
MAX_PROMPT_ARGV=80000
MAX_UNTRACKED_FILE_BYTES=65536

usage() {
  cat <<'USAGE'
grok-review — 只读审查 git diff / read-only Grok Build review

用法 / Usage:
  grok-review [--cwd DIR] [--base REF] [--head REF] [--model M] [--timeout SECS]
              [--diff-file FILE] [--] [extra instructions]

  grok-review --cwd path/to/worktree --base <start-sha>
  grok-review --base origin/main
  grok-review --range main...HEAD
  grok-review --diff-file changes.diff

选项 / Options:
  --cwd DIR          Repository or worktree to review (default: current directory)
  --base REF         Left side of the diff (default: HEAD). With no --head,
                     this is compared to the working tree (including unstaged).
  --head REF         Right side commit (optional). If set, review REF-to-REF
                     and ignore the working tree.
  --range A...B      Shortcut for git diff A...B (committed range only)
  --diff-file FILE   Use an existing patch instead of running git diff
  -m, --model M      Model slug (default: $REVIEW_MODEL, else grok's own default)
  -t, --timeout SECS Kill the CLI after SECS seconds (default: $REVIEW_TIMEOUT or 300)
  -h, --help         Show this help

环境变量 / Environment:
  REVIEW_MODEL       Optional model slug (passed as --model). See: grok models
  REVIEW_TIMEOUT     Default timeout in seconds (default: 300)
  AGENT_LOG_DIR      Log directory (default: ~/.agent-logs)
  GROK, GROK_BIN     Optional path to the grok binary

行为 / Behaviour:
  Read-only pre-merge review for the main agent (Codex). Prints findings
  as Blocking vs Non-blocking. This script never merges, pushes, or deletes.

  Official Grok Build flags (https://docs.x.ai/build/cli/reference,
  https://docs.x.ai/build/features/sandbox,
  https://docs.x.ai/build/enterprise):
       grok --sandbox read-only --permission-mode dontAsk
            --allow Read --allow Grep
            --deny Bash --deny Edit --deny WebFetch --deny WebSearch --deny MCPTool
            --disable-web-search --no-subagents --no-memory
            --no-auto-update --no-alt-screen --output-format plain
            --cwd <repo> -p <review request>

  Never --always-approve / --yolo / --dangerously-skip-permissions.
  The git diff is generated by this script and placed in the prompt (or a
  temp file). Secret paths (.env, *.p8, *.p12, *.mobileprovision) are
  listed but their contents are not sent.

  The main agent should treat only Blocking issues as merge-stoppers,
  and run at most two review rounds before asking a human.
USAGE
}

die() {
  printf '%s\n' "$SCRIPT_NAME: $*" >&2
  exit 1
}

# Portable timeout. Exit 124 on timeout (GNU timeout convention).
# macOS bash 3.2 has no builtin timeout(1); prefer timeout/gtimeout, else
# python3, else a perl watchdog. Do not use GNU-only flags.
run_with_timeout() {
  local secs
  secs=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
    return $?
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
    return $?
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import subprocess, sys
t = int(sys.argv[1])
cmd = sys.argv[2:]
try:
    r = subprocess.run(cmd, timeout=t)
    sys.exit(r.returncode if r.returncode is not None else 1)
except subprocess.TimeoutExpired:
    sys.exit(124)
except OSError as e:
    sys.stderr.write("failed to start command: %s\\n" % e)
    sys.exit(127)
' "$secs" "$@"
    return $?
  fi
  if command -v perl >/dev/null 2>&1; then
    perl -e '
      my $secs = shift;
      my $pid = fork();
      die "fork: $!\\n" unless defined $pid;
      if ($pid == 0) { exec @ARGV or die "exec: $!\\n"; }
      $SIG{ALRM} = sub {
        kill "TERM", $pid;
        select(undef, undef, undef, 2);
        kill "KILL", $pid;
        exit 124;
      };
      alarm $secs;
      waitpid($pid, 0);
      my $st = $?;
      alarm 0;
      if ($st & 127) { exit 128 + ($st & 127); }
      exit $st >> 8;
    ' "$secs" "$@"
    return $?
  fi
  die "no timeout helper found (need timeout, gtimeout, python3, or perl)"
}

find_grok() {
  local p
  if [ -n "${GROK_BIN:-}" ]; then
    if [ -x "$GROK_BIN" ]; then
      printf '%s\n' "$GROK_BIN"
      return 0
    fi
    die "GROK_BIN is set but not executable: $GROK_BIN"
  fi
  if [ -n "${GROK:-}" ]; then
    if [ -x "$GROK" ]; then
      printf '%s\n' "$GROK"
      return 0
    fi
    if command -v "$GROK" >/dev/null 2>&1; then
      command -v "$GROK"
      return 0
    fi
    die "GROK is set but not found: $GROK"
  fi
  if command -v grok >/dev/null 2>&1; then
    command -v grok
    return 0
  fi
  for p in "$HOME/.local/bin/grok" /usr/local/bin/grok; do
    if [ -x "$p" ]; then
      printf '%s\n' "$p"
      return 0
    fi
  done
  return 1
}


is_sensitive_name() {
  local base
  base=$(basename -- "$1")
  case "$base" in
    .env|.env.*)
      case "$base" in
        .env.example|.env.sample|.env.template|.env.example.*)
          return 1
          ;;
        *)
          return 0
          ;;
      esac
      ;;
    *.p8|*.p12|*.mobileprovision)
      return 0
      ;;
  esac
  return 1
}

# Return 0 if the spec text mentions sensitive files (fail closed).
# .env.example / .env.sample / .env.template alone are allowed.

phys_dir() {
  (cd -- "$1" && pwd -P)
}

ORIG_PWD=$(pwd)
model="${REVIEW_MODEL:-}"
timeout_secs="${REVIEW_TIMEOUT:-$DEFAULT_TIMEOUT}"
log_dir="${AGENT_LOG_DIR:-$HOME/.agent-logs}"
review_cwd=""
base_ref=""
head_ref=""
range_spec=""
diff_file=""
extra=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --cwd)
      [ $# -ge 2 ] || die "$1 requires an argument"
      review_cwd=$2
      shift 2
      ;;
    --base)
      [ $# -ge 2 ] || die "$1 requires an argument"
      base_ref=$2
      shift 2
      ;;
    --head)
      [ $# -ge 2 ] || die "$1 requires an argument"
      head_ref=$2
      shift 2
      ;;
    --range)
      [ $# -ge 2 ] || die "$1 requires an argument"
      range_spec=$2
      shift 2
      ;;
    --diff-file)
      [ $# -ge 2 ] || die "$1 requires an argument"
      diff_file=$2
      shift 2
      ;;
    -m|--model)
      [ $# -ge 2 ] || die "$1 requires an argument"
      model=$2
      shift 2
      ;;
    -t|--timeout)
      [ $# -ge 2 ] || die "$1 requires an argument"
      timeout_secs=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1 (try --help)"
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -gt 0 ]; then
  extra="$*"
fi

case "$timeout_secs" in
  ''|*[!0-9]*) die "timeout must be a positive integer, got: $timeout_secs" ;;
  0) die "timeout must be a positive integer, got: $timeout_secs" ;;
esac

if [ -n "$diff_file" ] && [ -n "$range_spec" ]; then
  die "use either --diff-file or --range, not both"
fi
if [ -n "$range_spec" ] && { [ -n "$base_ref" ] || [ -n "$head_ref" ]; }; then
  die "use either --range or --base/--head, not both"
fi

if [ -z "$review_cwd" ]; then
  review_cwd=$ORIG_PWD
fi
case "$review_cwd" in
  /*) ;;
  *) review_cwd="$ORIG_PWD/$review_cwd" ;;
esac
[ -d "$review_cwd" ] || die "not a directory: $review_cwd"
review_cwd=$(phys_dir "$review_cwd")

command -v git >/dev/null 2>&1 || die "git not found on PATH"
grok_bin=$(find_grok) || die "grok (Grok Build CLI) not found on PATH or in ~/.local/bin. Install from https://docs.x.ai/build/overview and log in once (run \`grok\` or \`grok login\`)."

if [ -z "$diff_file" ]; then
  if ! git -C "$review_cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "not inside a Git repository: $review_cwd"
  fi
fi

if [ -n "$diff_file" ]; then
  case "$diff_file" in
    /*) diff_abs=$diff_file ;;
    *) diff_abs="$ORIG_PWD/$diff_file" ;;
  esac
  [ -f "$diff_abs" ] || die "diff file not found: $diff_file"
  [ -r "$diff_abs" ] || die "diff file not readable: $diff_file"
fi

mkdir -p -- "$log_dir" || die "cannot create log dir: $log_dir"
ts=$(date +%Y%m%d-%H%M%S)
log_file="$log_dir/grok-review-${ts}-$$.log"

work=$(mktemp -d "${TMPDIR:-/tmp}/grok-review.XXXXXX") || die "mktemp failed"
trap 'if [ -n "${work:-}" ] && [ -d "$work" ]; then rm -rf -- "$work"; fi' EXIT
bundle="$work/REVIEW.md"
raw_diff="$work/raw.diff"
filtered_diff="$work/filtered.diff"

# Build the patch.
sensitive_skipped=""
untracked_note=""

if [ -n "$diff_file" ]; then
  cp -- "$diff_abs" "$raw_diff"
  range_label="--diff-file $diff_file"
elif [ -n "$range_spec" ]; then
  git -C "$review_cwd" diff "$range_spec" > "$raw_diff" || die "git diff $range_spec failed"
  range_label="git diff $range_spec"
else
  if [ -z "$base_ref" ]; then
    base_ref=HEAD
  fi
  if [ -n "$head_ref" ]; then
    git -C "$review_cwd" diff "$base_ref" "$head_ref" > "$raw_diff" || die "git diff $base_ref $head_ref failed"
    range_label="git diff $base_ref $head_ref"
  else
    git -C "$review_cwd" diff "$base_ref" > "$raw_diff" || die "git diff $base_ref failed"
    range_label="git diff $base_ref  (working tree)"
    # Untracked files: list all; inline small non-secret ones.
    untracked=$(git -C "$review_cwd" ls-files --others --exclude-standard || true)
    if [ -n "$untracked" ]; then
      untracked_note=$(printf '%s\n' "Untracked files:" "$untracked")
      while IFS= read -r path || [ -n "$path" ]; do
        [ -n "$path" ] || continue
        if is_sensitive_name "$path"; then
          sensitive_skipped=$(printf '%s\n%s' "$sensitive_skipped" "$path")
          continue
        fi
        abs="$review_cwd/$path"
        if [ ! -f "$abs" ]; then
          continue
        fi
        sz=$(wc -c < "$abs" | tr -d '[:space:]')
        case "$sz" in
          ''|*[!0-9]*) continue ;;
        esac
        if [ "$sz" -gt "$MAX_UNTRACKED_FILE_BYTES" ]; then
          untracked_note=$(printf '%s\n%s' "$untracked_note" "(omitted large untracked file $path, $sz bytes)")
          continue
        fi
        {
          printf '\n----- UNTRACKED FILE: %s (%s bytes) -----\n' "$path" "$sz"
          cat -- "$abs"
          printf '\n----- END UNTRACKED FILE: %s -----\n' "$path"
        } >> "$work/untracked.txt"
      done <<EOF
$untracked
EOF
    fi
  fi
fi

# Filter secret file hunks out of the patch (best-effort on git diffs).
# We still mention the paths so the reviewer knows they changed.
if [ -s "$raw_diff" ]; then
  # Collect paths from the diff.
  changed_paths=$(
    python3 -c '
import re, sys
text = open(sys.argv[1], "r", errors="replace").read()
paths = []
for m in re.finditer(r"(?m)^diff --git a/(.+?) b/(.+)$", text):
    paths.append(m.group(2))
if not paths:
    for m in re.finditer(r"(?m)^\+\+\+ b/(.+)$", text):
        if m.group(1) != "/dev/null":
            paths.append(m.group(1))
for p in paths:
    print(p)
' "$raw_diff" 2>/dev/null || true
  )
  while IFS= read -r path || [ -n "$path" ]; do
    [ -n "$path" ] || continue
    if is_sensitive_name "$path"; then
      sensitive_skipped=$(printf '%s\n%s' "$sensitive_skipped" "$path")
    fi
  done <<EOF
$changed_paths
EOF
  cp -- "$raw_diff" "$filtered_diff"
else
  : > "$filtered_diff"
fi

# If any sensitive paths appeared, strip their hunks (still listed in the prompt).
if [ -n "$sensitive_skipped" ]; then
  printf '%s\n' "$sensitive_skipped" | sed '/^$/d' | sort -u > "$work/skip.txt"
  python3 -c '
import re, sys
src, dest, skip_path = sys.argv[1], sys.argv[2], sys.argv[3]
skip = {line.strip() for line in open(skip_path, "r", errors="replace") if line.strip()}
text = open(src, "r", errors="replace").read()
parts = re.split(r"(?m)(?=^diff --git )", text)
out = []
for part in parts:
    m = re.match(r"diff --git a/(.+?) b/(.+?)\n", part)
    if m and (m.group(1) in skip or m.group(2) in skip):
        out.append("diff --git a/%s b/%s\n[content omitted: sensitive path]\n" % (m.group(1), m.group(2)))
    else:
        out.append(part)
open(dest, "w").write("".join(out))
' "$raw_diff" "$filtered_diff" "$work/skip.txt"
fi

diff_size=$(wc -c < "$filtered_diff" | tr -d '[:space:]')
case "$diff_size" in
  ''|*[!0-9]*) diff_size=0 ;;
esac

stat_txt=""
if [ -z "$diff_file" ]; then
  if [ -n "$range_spec" ]; then
    stat_txt=$(git -C "$review_cwd" diff --stat "$range_spec" || true)
  elif [ -n "$head_ref" ]; then
    stat_txt=$(git -C "$review_cwd" diff --stat "$base_ref" "$head_ref" || true)
  else
    stat_txt=$(git -C "$review_cwd" diff --stat "$base_ref" || true)
  fi
fi

if [ ! -s "$filtered_diff" ] && [ ! -f "$work/untracked.txt" ]; then
  printf '%s\n' "$SCRIPT_NAME: no changes to review ($range_label)."
  exit 0
fi

truncated_note=""
if [ "$diff_size" -gt "$MAX_DIFF_BYTES" ]; then
  truncated_note="The patch was truncated to $MAX_DIFF_BYTES bytes for this review."
  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import sys
src, dest, n = sys.argv[1], sys.argv[2], int(sys.argv[3])
data = open(src, "rb").read(n)
open(dest, "wb").write(data + b"\n[truncated]\n")
' "$filtered_diff" "$work/truncated.diff" "$MAX_DIFF_BYTES"
    mv -- "$work/truncated.diff" "$filtered_diff"
  fi
fi

{
  printf '%s\n' "You are a read-only code reviewer. Do not edit files, do not create files, and do not run shell commands."
  printf '%s\n' "Review the change described below. Reply in the same language as any extra instructions, or Chinese if none."
  printf '%s\n' "Structure your answer exactly as:"
  printf '%s\n' "  ## Blocking"
  printf '%s\n' "    Issues that must be fixed before merge (correctness, data loss, privilege, secrets, wrong user-visible messages, release incidents). If none, write 'None'."
  printf '%s\n' "  ## Non-blocking"
  printf '%s\n' "    Suggestions that should not stop the merge. If none, write 'None'."
  printf '%s\n' "  ## Notes"
  printf '%s\n' "    Optional context. Be concise; cite files and why it matters."
  printf '%s\n' "Only Blocking issues should be treated as merge-stoppers."
  printf '\n%s\n' "===== SCOPE ====="
  printf '%s\n' "Repository: $review_cwd"
  printf '%s\n' "Range: $range_label"
  if [ -n "$stat_txt" ]; then
    printf '\n%s\n%s\n' "git diff --stat:" "$stat_txt"
  fi
  if [ -n "$untracked_note" ]; then
    printf '\n%s\n' "$untracked_note"
  fi
  if [ -n "$sensitive_skipped" ]; then
    printf '\n%s\n' "Sensitive paths were omitted from the patch contents (review the paths, not the secrets):"
    printf '%s\n' "$sensitive_skipped" | sed '/^$/d' | sort -u
  fi
  if [ -n "$truncated_note" ]; then
    printf '\n%s\n' "$truncated_note"
  fi
  if [ -n "$extra" ]; then
    printf '\n%s\n\n%s\n' "===== EXTRA INSTRUCTIONS =====" "$extra"
  fi
  printf '\n%s\n\n' "===== PATCH ====="
  cat -- "$filtered_diff"
  if [ -f "$work/untracked.txt" ]; then
    printf '\n%s\n' "===== UNTRACKED FILE CONTENTS ====="
    cat -- "$work/untracked.txt"
  fi
} > "$bundle"

# If there is nothing useful after filtering, still review the stat/paths.
if [ ! -s "$filtered_diff" ] && [ ! -f "$work/untracked.txt" ] && [ -z "$sensitive_skipped" ]; then
  printf '%s\n' "$SCRIPT_NAME: no changes to review ($range_label)."
  exit 0
fi

prompt_size=$(wc -c < "$bundle" | tr -d '[:space:]')
if [ "$prompt_size" -le "$MAX_PROMPT_ARGV" ]; then
  prompt=$(cat -- "$bundle")
else
  prompt="You are a read-only code reviewer. Do not edit files or run shell commands. Read the review request at ${bundle} (it contains the patch, stats, and instructions). Structure your answer as ## Blocking, ## Non-blocking, and ## Notes. Only Blocking issues should stop a merge. If none, write 'None' under that heading."
fi

{
  printf '%s\n' "grok-review $ts"
  printf '%s\n' "grok=$grok_bin model=${model:-(grok default)} timeout=${timeout_secs}s"
  printf '%s\n' "cwd=$review_cwd range=$range_label"
  printf '%s\n' "log=$log_file"
  printf '%s\n' "----- request -----"
  cat -- "$bundle"
  printf '\n%s\n' "----- grok output -----"
} > "$log_file"

if [ -n "$sensitive_skipped" ]; then
  printf '%s\n' "$SCRIPT_NAME: warning: omitted sensitive path contents from the review payload:" >&2
  printf '%s\n' "$sensitive_skipped" | sed '/^$/d' | sort -u >&2
fi

printf '%s\n' "$SCRIPT_NAME: reviewing $range_label in $review_cwd (timeout ${timeout_secs}s, log $log_file) ..." >&2

set -- \
  "$grok_bin" \
  --no-auto-update \
  --no-alt-screen \
  --output-format plain \
  --sandbox read-only \
  --permission-mode dontAsk \
  --allow Read \
  --allow Grep \
  --deny Bash \
  --deny Edit \
  --deny WebFetch \
  --deny WebSearch \
  --deny MCPTool \
  --disable-web-search \
  --no-subagents \
  --no-memory \
  --cwd "$review_cwd"

if [ -n "$model" ]; then
  set -- "$@" --model "$model"
fi
set -- "$@" -p "$prompt"

set +e
(
  cd -- "$review_cwd" || exit 1
  run_with_timeout "$timeout_secs" "$@" </dev/null
) > "$work/stdout.txt" 2> "$work/stderr.txt"
rc=$?
set -e

if [ -s "$work/stderr.txt" ]; then
  cat -- "$work/stderr.txt" >> "$log_file"
  cat -- "$work/stderr.txt" >&2
fi
if [ -s "$work/stdout.txt" ]; then
  cat -- "$work/stdout.txt" >> "$log_file"
  cat -- "$work/stdout.txt"
  case "$(tail -c 1 "$work/stdout.txt" 2>/dev/null | od -An -t x1)" in
    *0a*) ;;
    *) printf '\n' ;;
  esac
fi

printf '\n%s\n' "----- exit $rc -----" >> "$log_file"

if [ "$rc" -eq 124 ]; then
  die "grok timed out after ${timeout_secs}s (log: $log_file)"
fi
if [ "$rc" -ne 0 ]; then
  die "grok exited $rc (log: $log_file). If the message is about authentication, run \`grok login\` once. Do not paste an API key into this script."
fi
if [ ! -s "$work/stdout.txt" ]; then
  printf '%s\n' "$SCRIPT_NAME: warning: grok produced no stdout (log: $log_file)" >&2
fi

exit 0
